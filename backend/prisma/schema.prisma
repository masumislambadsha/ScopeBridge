generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------
enum WorkspaceRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  E_COMMERCE
  SAAS
  MOBILE_APP
  WEBSITE
  CUSTOM
}

enum InvitationType {
  MEMBER
  CLIENT_PORTAL
}

enum InformationRequestType {
  INITIAL
  CLARIFICATION
}

enum InformationRequestStatus {
  DRAFT
  SENT
  ANSWERED
  CLOSED
}

enum SubmissionStatus {
  RECEIVED
  PROCESSING
  EXTRACTED
  AI_FAILED
}

enum FileExtractionStatus {
  PENDING
  EXTRACTED
  UNSUPPORTED
  FAILED
}

enum RequirementStatus {
  DRAFT
  NEEDS_CLARIFICATION
  READY
  APPROVED
  REJECTED
}

enum RequirementSource {
  AI
  MANUAL
  CHANGE_REQUEST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AcceptanceCriteriaStatus {
  NONE
  AI_DRAFT
  REVIEWED
}

enum ScopeVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUPERSEDED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum ChangeRequestStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
}

enum ClientApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum AiClassification {
  IN_SCOPE
  OUT_OF_SCOPE
  POSSIBLY_RELATED
}

enum AiFeature {
  CHECKLIST
  EXTRACTION
  READINESS
  ACCEPTANCE_CRITERIA
  SCOPE_CHANGE
}

enum AiRunStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageVisibility {
  CLIENT
  INTERNAL
}

enum ActorType {
  USER
  CLIENT
  SYSTEM
  AI
}

// ---------- Models ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedWorkspaces      Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  projectMemberships   ProjectMember[]
  createdRequests      InformationRequest[] @relation("RequestCreator")
  createdScopeVersions ScopeVersion[]     @relation("ScopeVersionCreator")
  requestedApprovals   Approval[]         @relation("ApprovalRequester")
  decidedApprovals     Approval[]         @relation("ApprovalDecider")
  assignedTasks        Task[]             @relation("TaskAssignee")
  createdTasks         Task[]             @relation("TaskCreator")
  sentMessages         Message[]
  notifications        Notification[]
  activityLogs         ActivityLog[]      @relation("LogActor")
  passwordResetTokens  PasswordResetToken[]
  portalClients        Client[]           @relation("ClientPortalUser")
  sentInvitations      Invitation[]       @relation("InvitationSender")
  submittedSubmissions Submission[]       @relation("SubmissionSubmitter")
  uploadedFiles        File[]             @relation("FileUploader")
  createdRequirements  Requirement[]      @relation("RequirementCreator")
  approvedRequirements Requirement[]      @relation("RequirementApprover")
  requestedCRs         ChangeRequest[]    @relation("CRRequester")
  reviewedCRs          ChangeRequest[]    @relation("CRReviewer")
  decidedCRs           ChangeRequest[]    @relation("CRDecider")
  aiRuns               AiRun[]            @relation("AiRunCreator")

  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  settings    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  invitations Invitation[]
  clients     Client[]
  projects    Project[]
  activityLogs ActivityLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(TEAM_MEMBER)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Invitation {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        InvitationType
  email       String
  role        WorkspaceRole?
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash   String         @unique
  invitedById String
  invitedBy   User           @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([workspaceId])
  @@index([email])
  @@index([clientId])
}

model Client {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  email        String
  company      String?
  phone        String?
  contactName  String?
  address      String?
  notes        String?
  status       ClientStatus @default(ACTIVE)
  portalUserId String?      @unique
  portalUser   User?        @relation("ClientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  projects     Project[]
  submissions  Submission[]
  approvals    Approval[]
  changeRequests ChangeRequest[]
  invitations  Invitation[]

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([portalUserId])
}

model Project {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  projectType    ProjectType   @default(CUSTOM)
  projectTypeLabel String?
  startDate      DateTime?
  deadline       DateTime?
  status         ProjectStatus @default(PLANNING)
  requirementSeq Int           @default(0)
  taskSeq        Int           @default(0)
  crSeq          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  members             ProjectMember[]
  informationRequests InformationRequest[]
  submissions         Submission[]
  files               File[]
  requirements        Requirement[]
  scope               Scope?
  tasks               Task[]
  changeRequests      ChangeRequest[]
  messages            Message[]
  activityLogs        ActivityLog[]
  readinessReports    ReadinessReport[]
  aiRuns              AiRun[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([workspaceId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model InformationRequest {
  id             String                   @id @default(cuid())
  projectId      String
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                     @relation("RequestCreator", fields: [createdById], references: [id])
  type           InformationRequestType   @default(INITIAL)
  title          String
  description    String?
  questions      Json                     @default("[]")
  deadline       DateTime?
  status         InformationRequestStatus @default(DRAFT)
  sentAt         DateTime?
  lastReminderAt DateTime?
  reminderCount  Int                      @default(0)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  submissions             Submission[]
  clarificationRequirements Requirement[] @relation("RequirementClarification")

  @@index([projectId])
  @@index([projectId, status])
}

model Submission {
  id                   String           @id @default(cuid())
  projectId            String
  project              Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId             String
  client               Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  submittedById        String
  submittedBy          User             @relation("SubmissionSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  informationRequestId String?
  informationRequest   InformationRequest? @relation(fields: [informationRequestId], references: [id], onDelete: SetNull)
  answers              Json             @default("{}")
  additionalInfo       String?
  status               SubmissionStatus @default(RECEIVED)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  requirements Requirement[]
  files        File[]

  @@index([projectId])
  @@index([clientId])
  @@index([informationRequestId])
}

model File {
  id               String               @id @default(cuid())
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissionId     String?
  submission       Submission?          @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  changeRequestId  String?
  changeRequest    ChangeRequest?       @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  uploadedById     String
  uploadedBy       User                 @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName     String
  mimeType         String
  size             Int
  storageKey       String
  url              String?
  extractionStatus FileExtractionStatus @default(PENDING)
  extractedText    String?
  createdAt        DateTime             @default(now())

  requirements Requirement[]

  @@index([projectId])
  @@index([submissionId])
  @@index([changeRequestId])
}

model Requirement {
  id                       String                   @id @default(cuid())
  projectId                String
  project                  Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                     String
  title                    String
  description              String?
  category                 String                   @default("general")
  priority                 Priority                 @default(MEDIUM)
  status                   RequirementStatus        @default(DRAFT)
  source                   RequirementSource        @default(MANUAL)
  sourceContext            String?
  submissionId             String?
  submission               Submission?              @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  fileId                   String?
  file                     File?                    @relation(fields: [fileId], references: [id], onDelete: SetNull)
  changeRequestId          String?
  changeRequest            ChangeRequest?           @relation("CRRequirements", fields: [changeRequestId], references: [id], onDelete: SetNull)
  clarificationRequestId   String?
  clarificationRequest     InformationRequest?      @relation("RequirementClarification", fields: [clarificationRequestId], references: [id], onDelete: SetNull)
  acceptanceCriteria       Json                     @default("[]")
  acceptanceCriteriaStatus AcceptanceCriteriaStatus @default(NONE)
  aiFlags                  Json?
  confidence               Float?
  approvedById             String?
  approvedBy               User?                    @relation("RequirementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt               DateTime?
  createdById              String?
  createdBy                User?                    @relation("RequirementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tasks           Task[]
  scopeVersionLinks ScopeVersionRequirement[]

  @@unique([projectId, code])
  @@index([projectId])
  @@index([projectId, status])
  @@index([submissionId])
  @@index([changeRequestId])
}

model ReadinessReport {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aiRunId            String?  @unique
  aiRun              AiRun?   @relation(fields: [aiRunId], references: [id], onDelete: SetNull)
  score              Int
  summary            String?
  missingInformation Json     @default("[]")
  ambiguous          Json     @default("[]")
  contradictions     Json     @default("[]")
  incomplete         Json     @default("[]")
  unclear            Json     @default("[]")
  perRequirement     Json     @default("[]")
  createdAt          DateTime @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
}

model Scope {
  id                String   @id @default(cuid())
  projectId         String   @unique
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String   @default("Project Scope")
  approvedVersionId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  versions ScopeVersion[] @relation("ScopeVersions")
  approvals Approval[]

  @@index([projectId])
}

model ScopeVersion {
  id               String             @id @default(cuid())
  scopeId          String
  scope            Scope              @relation("ScopeVersions", fields: [scopeId], references: [id], onDelete: Cascade)
  version          Int
  status           ScopeVersionStatus @default(DRAFT)
  summary          String?
  features         Json               @default("[]")
  deliverables     Json               @default("[]")
  exclusions       Json               @default("[]")
  priority         Priority           @default(MEDIUM)
  deadline         DateTime?
  basedOnVersionId String?
  basedOn          ScopeVersion?      @relation("VersionLineage", fields: [basedOnVersionId], references: [id], onDelete: SetNull)
  derivedVersions  ScopeVersion[]     @relation("VersionLineage")
  createdById      String
  createdBy        User               @relation("ScopeVersionCreator", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  submittedAt      DateTime?
  approvedAt       DateTime?

  approvals        Approval[]
  requirementLinks ScopeVersionRequirement[]
  tasks            Task[]
  baseForCRs       ChangeRequest[] @relation("CRBaseVersion")
  proposedForCRs   ChangeRequest[] @relation("CRProposedVersion")
  resultingForCRs  ChangeRequest[] @relation("CRResultingVersion")

  @@unique([scopeId, version])
  @@index([scopeId])
  @@index([scopeId, status])
}

model ScopeVersionRequirement {
  id             String       @id @default(cuid())
  scopeVersionId String
  scopeVersion   ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)
  requirementId  String
  requirement    Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([scopeVersionId, requirementId])
  @@index([scopeVersionId])
  @@index([requirementId])
}

model Approval {
  id             String         @id @default(cuid())
  scopeId        String
  scope          Scope          @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  scopeVersionId String
  scopeVersion   ScopeVersion   @relation(fields: [scopeVersionId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById  String
  requestedBy    User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  status         ApprovalStatus @default(PENDING)
  decidedById    String?
  decidedBy      User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt      DateTime?
  comment        String?
  signatureName  String?
  contentHash    String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())

  @@index([scopeId])
  @@index([scopeVersionId])
  @@index([clientId])
  @@index([status])
}

model Task {
  id                 String     @id @default(cuid())
  projectId          String
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code               String
  title              String
  description        String?
  requirementId      String?
  requirement        Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  scopeVersionId     String
  scopeVersion       ScopeVersion @relation(fields: [scopeVersionId], references: [id], onDelete: Restrict)
  changeRequestId    String?
  changeRequest      ChangeRequest? @relation("CRTasks", fields: [changeRequestId], references: [id], onDelete: SetNull)
  assigneeId         String?
  assignee           User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User       @relation("TaskCreator", fields: [createdById], references: [id])
  priority           Priority   @default(MEDIUM)
  status             TaskStatus @default(TODO)
  deadline           DateTime?
  completedAt        DateTime?
  deadlineNotifiedAt DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@index([assigneeId])
  @@index([projectId, status])
  @@index([scopeVersionId])
  @@index([changeRequestId])
}

model ChangeRequest {
  id                     String               @id @default(cuid())
  projectId              String
  project                Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code                   String
  clientId               String
  client                 Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedById          String
  requestedBy            User                 @relation("CRRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  baseScopeVersionId     String?
  baseScopeVersion       ScopeVersion?        @relation("CRBaseVersion", fields: [baseScopeVersionId], references: [id], onDelete: SetNull)
  title                  String
  description            String
  status                 ChangeRequestStatus  @default(PENDING)
  clientApprovalStatus   ClientApprovalStatus @default(PENDING)
  aiClassification       AiClassification?
  aiImpact               Json?
  aiRationale            String?
  aiMatchedItems         Json?
  aiSuggestedRequirements Json?
  aiAnalyzedAt           DateTime?
  finalClassification    AiClassification?
  estimatedHours         Float?
  estimatedCost          Decimal?
  timelineImpactDays     Int?
  pmNote                 String?
  reviewedById           String?
  reviewedBy             User?                @relation("CRReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  decidedById            String?
  decidedBy              User?                @relation("CRDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt              DateTime?
  proposedScopeVersionId String?
  proposedScopeVersion   ScopeVersion?        @relation("CRProposedVersion", fields: [proposedScopeVersionId], references: [id], onDelete: SetNull)
  resultingScopeVersionId String?
  resultingScopeVersion  ScopeVersion?        @relation("CRResultingVersion", fields: [resultingScopeVersionId], references: [id], onDelete: SetNull)
  implementedAt          DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  files        File[]
  tasks        Task[]        @relation("CRTasks")
  requirements Requirement[] @relation("CRRequirements")

  @@unique([projectId, code])
  @@index([projectId])
  @@index([projectId, status])
  @@index([clientId])
}

model Message {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content    String
  visibility MessageVisibility @default(CLIENT)
  createdAt  DateTime          @default(now())

  @@index([projectId])
  @@index([projectId, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  link       String?
  projectId  String?
  entityId   String?
  entityType String?
  read       Boolean  @default(false)
  readAt     DateTime?
  emailedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([userId, read, createdAt])
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorId     String?
  actor       User?    @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorType   ActorType @default(USER)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

model AiRun {
  id         String      @id @default(cuid())
  feature    AiFeature
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  entityType String?
  entityId   String?
  status     AiRunStatus @default(QUEUED)
  model      String?
  latencyMs  Int?
  error      String?
  output     Json?
  createdById String?
  createdBy  User?       @relation("AiRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  finishedAt DateTime?

  readinessReport ReadinessReport?

  @@index([projectId])
  @@index([feature, status])
  @@index([entityType, entityId])
}
