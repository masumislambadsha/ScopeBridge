# ---- Shared ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scopebridge?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scopebridge?schema=public"
REDIS_URL="redis://localhost:6379"
NODE_ENV="development"

# ---- Backend ----
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:4000"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-001"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-002"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# ---- AI ----
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---- Storage ----
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email (Mailpit defaults for local) ----
MAIL_ENABLED=true
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ScopeBridge <no-reply@scopebridge.app>"

# ---- Rate limits ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_AI_MAX=60

# ---- Frontend ----
BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
